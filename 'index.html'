(function() {
    'use strict';

    // ---------- CONFIG ----------
    const ASSETS = ['EUR/USD OTC', 'GBP/USD OTC', 'USD/JPY OTC', 'AUD/USD OTC', 'BTC/USD OTC'];
    const REFRESH_MS = 3000;

    // ---------- STATE ----------
    let activeAsset = ASSETS[0];
    let priceHistory = {};   // { asset: [prices] }
    let signalLog = [];
    let tickCounter = 0;

    ASSETS.forEach(a => priceHistory[a] = []);

    // ---------- UTILS ----------
    function rand(min, max) { return Math.random() * (max - min) + min; }

    function fmt(n, d = 5) {
        if (n === null || n === undefined || isNaN(n)) return '--';
        return Number(n).toFixed(d);
    }

    function nowTime() {
        return new Date().toLocaleTimeString('uz-UZ', { hour12: false });
    }

    // ---------- SIMULATED PRICE FEED ----------
    // Haqiqiy OTC API mavjud bo'lmagani uchun tasodifiy yurish simulyatsiyasi.
    function generateNextPrice(asset) {
        const hist = priceHistory[asset];
        let last = hist.length ? hist[hist.length - 1] : rand(1.0800, 1.0900);
        if (asset.includes('JPY')) last = hist.length ? hist[hist.length-1] : rand(148, 152);
        if (asset.includes('BTC')) last = hist.length ? hist[hist.length-1] : rand(60000, 70000);
        const volatility = asset.includes('BTC') ? 50 : (asset.includes('JPY') ? 0.05 : 0.0004);
        return last + rand(-volatility, volatility);
    }

    // ---------- INDICATOR CALCULATIONS ----------

    function calcRSI(prices, period = 14) {
        if (prices.length < period + 1) return null;
        let gains = 0, losses = 0;
        for (let i = prices.length - period; i < prices.length; i++) {
            const diff = prices[i] - prices[i - 1];
            if (diff >= 0) gains += diff; else losses -= diff;
        }
        const avgGain = gains / period;
        const avgLoss = losses / period;
        if (avgLoss === 0) return 100;
        const rs = avgGain / avgLoss;
        return 100 - (100 / (1 + rs));
    }

    function calcEMA(prices, period) {
        if (prices.length < period) return null;
        const k = 2 / (period + 1);
        let ema = prices.slice(0, period).reduce((a, b) => a + b, 0) / period;
        for (let i = period; i < prices.length; i++) {
            ema = prices[i] * k + ema * (1 - k);
        }
        return ema;
    }

    function calcMACD(prices) {
        const ema12 = calcEMA(prices, 12);
        const ema26 = calcEMA(prices, 26);
        if (ema12 === null || ema26 === null) return null;
        return ema12 - ema26;
    }

    function calcBollinger(prices, period = 20, mult = 2) {
        if (prices.length < period) return null;
        const slice = prices.slice(-period);
        const sma = slice.reduce((a, b) => a + b, 0) / period;
        const variance = slice.reduce((a, b) => a + (b - sma) ** 2, 0) / period;
        const sd = Math.sqrt(variance);
        return { upper: sma + mult * sd, lower: sma - mult * sd, mid: sma };
    }

    function calcStochastic(prices, period = 14) {
        if (prices.length < period) return null;
        const slice = prices.slice(-period);
        const high = Math.max(...slice);
        const low = Math.min(...slice);
        const close = prices[prices.length - 1];
        if (high === low) return 50;
        return ((close - low) / (high - low)) * 100;
    }

    // ---------- REVERSE RSI (Teskari hisoblash) ----------
    // RSI formulasini teskari yechish orqali berilgan RSI darajasiga mos narxni topadi.
    // RSI = 100 - (100 / (1 + RS)), RS = avgGain / avgLoss
    // Agar maqsad RSI = target bo'lsa:
    //   target = 100 - 100/(1+RS)  =>  RS = (100/(100-target)) - 1
    //   avgGain / avgLoss = RS
    // Joriy o'rtacha gain/loss nisbatidan foydalanib, kerakli narx o'zgarishini taxmin qilamiz.
    function reverseRSI(prices, period = 14, targetRSI = 70) {
        if (prices.length < period + 1) return null;

        // Joriy avgGain va avgLoss ni hisoblash
        let gains = 0, losses = 0;
        for (let i = prices.length - period; i < prices.length; i++) {
            const diff = prices[i] - prices[i - 1];
            if (diff >= 0) gains += diff; else losses -= diff;
        }
        const avgGain = gains / period;
        const avgLoss = losses / period;

        // Maqsad RS
        const targetRS = (100 / (100 - targetRSI)) - 1;
        if (targetRS <= 0) return null;

        // Kerakli avgGain (avgLoss ni o'zgarmas deb hisoblaymiz)
        const requiredGain = targetRS * avgLoss;

        // Joriy narxdan kerakli narxga o'tish uchun zarur bo'lgan o'rtacha o'sish
        // requiredGain = (jami gain) / period  => jami gain = requiredGain * period
        // Hozirgi jami gain = avgGain * period
        // Farq = (requiredGain - avgGain) * period
        // Bu farqni joriy narxga qo'shamiz (agar ijobiy bo'lsa) yoki ayiramiz.
        const deltaTotal = (requiredGain - avgGain) * period;
        const currentPrice = prices[prices.length - 1];

        // Agar targetRSI > joriy RSI bo'lsa, narx o'sishi kerak; aks holda tushishi.
        const currentRSI = calcRSI(prices, period);
        let projectedPrice;
        if (targetRSI > currentRSI) {
            projectedPrice = currentPrice + Math.abs(deltaTotal);
        } else {
            projectedPrice = currentPrice - Math.abs(deltaTotal);
        }

        // Agar avgLoss = 0 (RSI=100), maxsus holat
        if (avgLoss === 0 && targetRSI < 100) {
            // Narx tushishi kerak
            const syntheticLoss = (avgGain * period) / targetRS;
            projectedPrice = currentPrice - syntheticLoss;
        }

        return projectedPrice;
    }

    // ---------- SIGNAL GENERATION ----------
    function generateSignal(asset) {
        const prices = priceHistory[asset];
        if (prices.length < 30) return { dir: 'WAIT', confidence: 0, expiry: '--' };

        const rsi = calcRSI(prices);
        const macd = calcMACD(prices);
        const ema20 = calcEMA(prices, 20);
        const ema50 = calcEMA(prices, 50);
        const bb = calcBollinger(prices);
        const stoch = calcStochastic(prices);
        const price = prices[prices.length - 1];

        let score = 0;
        let reasons = [];

        // RSI
        if (rsi !== null) {
            if (rsi < 30) { score += 1; reasons.push('RSI oversold'); }
            else if (rsi > 70) { score -= 1; reasons.push('RSI overbought'); }
        }
        // MACD
        if (macd !== null) {
            if (macd > 0) { score += 0.5; } else { score -= 0.5; }
        }
        // EMA trend
        if (ema20 !== null && ema50 !== null) {
            if (ema20 > ema50) { score += 1; } else { score -= 1; }
        }
        // Bollinger
        if (bb !== null) {
            if (price <= bb.lower) { score += 1; reasons.push('Pastki band'); }
            else if (price >= bb.upper) { score -= 1; reasons.push('Yuqori band'); }
        }
        // Stochastic
        if (stoch !== null) {
            if (stoch < 20) { score += 0.5; } else if (stoch > 80) { score -= 0.5; }
        }

        let dir = 'WAIT';
        let confidence = 0;
        if (score >= 2) { dir = 'CALL'; confidence = Math.min(95, 50 + score * 10); }
        else if (score <= -2) { dir = 'PUT'; confidence = Math.min(95, 50 + Math.abs(score) * 10); }
        else { dir = 'WAIT'; confidence = 40; }

        // Expiry tavsiyasi
        let expiry = '--';
        if (dir !== 'WAIT') {
            const volatility = Math.abs(prices[prices.length-1] - prices[prices.length-2]) / prices[prices.length-2];
            if (volatility > 0.001) expiry = '1 daqiqa';
            else if (volatility > 0.0003) expiry = '2 daqiqa';
            else expiry = '5 daqiqa';
        }

        return { dir, confidence, expiry, reasons, score };
    }

    // ---------- UI UPDATE ----------
    function updateUI() {
        const asset = activeAsset;
        const prices = priceHistory[asset];

        // Signal
        const sig = generateSignal(asset);
        const sigText = document.getElementById('signalText');
        const sigSub = document.getElementById('signalSub');
        sigText.className = 'signal-' + sig.dir.toLowerCase();
        sigText.textContent = sig.dir === 'WAIT' ? 'KUTISH' : sig.dir;
        sigSub.textContent = sig.dir === 'WAIT'
            ? 'Shartlar yetarli emas'
            : (sig.reasons && sig.reasons.length ? sig.reasons.join(' · ') : 'Indikatorlar mos');

        document.getElementById('confidence').textContent = sig.confidence + '%';
        document.getElementById('confidence').className = 'metric-value ' +
            (sig.confidence >= 70 ? 'up' : sig.confidence >= 50 ? 'neutral' : 'down');
        document.getElementById('expiry').textContent = sig.expiry;

        // Indicators
        const rsi = calcRSI(prices);
        const macd = calcMACD(prices);
        const ema20 = calcEMA(prices, 20);
        const ema50 = calcEMA(prices, 50);
        const bb = calcBollinger(prices);
        const stoch = calcStochastic(prices);

